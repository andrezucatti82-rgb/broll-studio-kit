{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"B-roll Studio intake",
  "type":"object",
  "required":["schemaVersion","topic"],
  "properties":{
    "schemaVersion":{"const":1},
    "topic":{"type":"string","minLength":1},
    "brand":{"type":"object","properties":{"name":{"type":"string"},"website":{"type":"string"},"logo":{"type":"string"}}},
    "duration":{"type":"number","minimum":6,"maximum":180},
    "format":{"enum":["9:16","16:9","1:1"]},
    "language":{"type":"string"},
    "avatar":{"type":"boolean","default":false}
  }
}
